{
    "name": "memory-haven-backend",
    "version": "1.0.0",
    "description": "API Backend Memory Haven - Plateforme familiale de souvenirs",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/app.js",
        "build": "prisma generate && prisma db push",
        "start:prod": "prisma db push && node prisma/seed.js && node src/app.js",
        "dev": "node scripts/ensure-local-db.js && prisma generate && nodemon src/app.js",
        "dev:quick": "nodemon src/app.js",
        "postinstall": "prisma generate",
        "db:push": "prisma db push",
        "db:seed": "node prisma/seed.js",
        "db:setup": "prisma db push && node prisma/seed.js",
        "auth:link": "node scripts/link-supabase-auth.js",
        "test": "node --test tests/**/*.test.js"
    },
    "prisma": {
        "seed": "node prisma/seed.js"
    },
    "dependencies": {
        "@prisma/client": "^5.22.0",
        "@supabase/supabase-js": "^2.107.0",
        "bcrypt": "^5.1.1",
        "cloudinary": "^1.41.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.7",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "multer": "^1.4.5-lts.1",
        "nodemailer": "^8.0.10",
        "prisma": "^5.22.0",
        "qrcode": "^1.5.4",
        "socket.io": "^4.8.1",
        "speakeasy": "^2.0.0"
    },
    "devDependencies": {
        "better-sqlite3": "^12.10.0",
        "nodemon": "^3.1.9"
    }
}
