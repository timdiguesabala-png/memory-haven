# Production — Supabase (PostgreSQL + Storage) + API Render
NODE_ENV=production
PORT=10000

# Supabase PostgreSQL (Settings → Database → Connection string)
# Pooler transaction (6543) pour l'API en runtime :
DATABASE_URL=postgresql://postgres.VOTRE_REF:VOTRE_MDP@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct (5432) pour prisma db push / migrations :
DIRECT_URL=postgresql://postgres.VOTRE_REF:VOTRE_MDP@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

JWT_SECRET=changez_moi_longue_phrase_secrete

# Supabase Storage (Settings → API)
SUPABASE_URL=https://VOTRE_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=votre_service_role_secret
# Optionnel — vérifie les tokens Supabase côté API Render (Settings → API → JWT Secret)
# SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=memory-haven

# URL publique de l'API Render (sans slash final)
PUBLIC_API_URL=https://memory-haven-api.onrender.com
FRONTEND_URL=https://memory-haven-frontend.vercel.app

# Optionnel — Cloudinary en plus ou à la place de Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Fallback uploads locaux si Storage indisponible (déconseillé en prod)
# ALLOW_LOCAL_UPLOAD_FALLBACK=false
